# Config git partagée, incluse depuis ~/.gitconfig par install.sh ([include] path).
# L'identité (user.name / user.email) reste dans ~/.gitconfig, propre à chaque machine.

[protocol]
	version = 2
[core]
	editor = code --wait
[push]
	autoSetupRemote = true
[alias]
	co = checkout
	amend = commit --amend --no-edit
	rewrite = rebase -i master
	home = checkout master
